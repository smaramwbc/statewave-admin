# =============================================================================
# statewave-admin environment configuration
#
# All variables below are SERVER-SIDE ONLY. NEVER use a VITE_* prefix for any
# of them — VITE_* values are baked into the client JavaScript bundle and
# would expose secrets to anyone loading the page.
#
# This config is intentionally vendor-neutral: works with the standalone Node
# server (npm start), Docker, behind nginx/Caddy/Traefik/HAProxy/Cloudflare,
# on Kubernetes, or any host that runs Node.
# =============================================================================

# ─── Backend (proxied through /api/proxy) ───────────────────────────────────
STATEWAVE_API_URL=http://localhost:8100
STATEWAVE_API_KEY=

# ─── Built-in admin password gate (REQUIRED in production) ──────────────────
# Generate ADMIN_PASSWORD with a long random value (e.g. `openssl rand -base64 32`).
# Generate ADMIN_SESSION_SECRET with at least 32 random bytes
# (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Session cookie lifetime in hours (default: 12).
ADMIN_SESSION_TTL_HOURS=12

# Disable the built-in gate. ONLY for local development. In production this
# must be `false`; when true, a visible warning banner is shown in the UI.
ADMIN_AUTH_DISABLED=false

# ─── Optional external gateway integration ──────────────────────────────────
# When you front the admin with Cloudflare Access, OAuth2 Proxy, IAP, an
# OIDC reverse proxy, etc., set this to true and the proxy will accept the
# gateway's identity header in lieu of a built-in session.
ADMIN_TRUST_GATEWAY_HEADERS=false

# Comma-separated allowlist of operator emails. Only honored when
# ADMIN_TRUST_GATEWAY_HEADERS=true. Empty = any authenticated gateway user.
# Recognized inbound headers (first non-empty wins):
#   Cf-Access-Authenticated-User-Email
#   X-Forwarded-User
#   X-Admin-Email
ADMIN_ALLOWED_EMAILS=

# ─── Standalone Node server (`npm start`) ───────────────────────────────────
PORT=8080
HOST=0.0.0.0
ADMIN_STATIC_DIR=./dist

# ─── Self-Healing Eval (admin-triggered, LLM-graded) ─────────────────────────
# Disabled by default. The /diagnostics card stays "not available" until
# every field below is set. See README.md#self-healing-eval for details.
ADMIN_SELF_HEALING_EVAL_ENABLED=false

# LLM judge: openai | anthropic | openai-compatible
#   - openai            — talks to https://api.openai.com (Authorization: Bearer)
#   - anthropic         — talks to https://api.anthropic.com (x-api-key)
#   - openai-compatible — any /v1/chat/completions-shaped endpoint:
#                         a LiteLLM proxy, an Azure OpenAI gateway behind
#                         LiteLLM, a self-hosted vLLM, Ollama with the
#                         OpenAI shim, etc. Set ADMIN_EVAL_LLM_BASE_URL
#                         to the proxy/gateway root.
ADMIN_EVAL_LLM_PROVIDER=
ADMIN_EVAL_LLM_MODEL=
ADMIN_EVAL_LLM_API_KEY=
# REQUIRED for openai-compatible. Examples:
#   http://localhost:4000                       # local LiteLLM proxy
#   https://litellm.example.com                 # hosted LiteLLM proxy
#   https://<resource>.openai.azure.com         # Azure OpenAI gateway via LiteLLM
ADMIN_EVAL_LLM_BASE_URL=

# Demo agent the eval talks to. Expected request shape:
#   POST <url> { subject_id, session_id, agent_id, messages: [{role, content}] }
# Lenient response parsing: { message } | { answer } | { text } |
# { reply } | { choices: [{ message: { content } }] }
ADMIN_DEMO_AGENT_URL=
ADMIN_DEMO_AGENT_API_KEY=
# Optional: switch the request body shape. "default" sends the eval's native
# body. "statewave-web" translates to {messages, mode, persona} so the
# existing /api/widget-chat endpoint in statewave-web can be used as-is.
ADMIN_DEMO_AGENT_BODY_FORMAT=default
# Used only by the statewave-web body format — picks the persona id.
# Default: statewave-support (docs-grounded persona).
ADMIN_DEMO_AGENT_PERSONA=

# Reserved / informational in this MVP. Webhook delivery validation reuses the
# existing Statewave smoke-check path (observes STATEWAVE_WEBHOOK_URL on the
# Statewave server). See README for the webhook validation note.
ADMIN_DEMO_WEBHOOK_URL=

# Optional directory for persisting redacted JSON reports across restarts.
ADMIN_EVAL_STORAGE_PATH=
