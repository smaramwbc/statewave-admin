# =============================================================================
# statewave-admin environment configuration
#
# All variables below are SERVER-SIDE ONLY. NEVER use a VITE_* prefix for any
# of them — VITE_* values are baked into the client JavaScript bundle and
# would expose secrets to anyone loading the page.
#
# This config is intentionally vendor-neutral: works with the standalone Node
# server (npm start), Docker, behind nginx/Caddy/Traefik/HAProxy/Cloudflare,
# on Kubernetes, or any host that runs Node.
# =============================================================================

# ─── Backend (proxied through /api/proxy) ───────────────────────────────────
STATEWAVE_API_URL=http://localhost:8100
STATEWAVE_API_KEY=

# ─── Built-in admin password gate (REQUIRED in production) ──────────────────
# Generate ADMIN_PASSWORD with a long random value (e.g. `openssl rand -base64 32`).
# Generate ADMIN_SESSION_SECRET with at least 32 random bytes
# (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Session cookie lifetime in hours (default: 12).
ADMIN_SESSION_TTL_HOURS=12

# Disable the built-in gate. ONLY for local development. In production this
# must be `false`; when true, a visible warning banner is shown in the UI.
ADMIN_AUTH_DISABLED=false

# ─── Optional external gateway integration ──────────────────────────────────
# When you front the admin with Cloudflare Access, OAuth2 Proxy, IAP, an
# OIDC reverse proxy, etc., set this to true and the proxy will accept the
# gateway's identity header in lieu of a built-in session.
ADMIN_TRUST_GATEWAY_HEADERS=false

# Comma-separated allowlist of operator emails. Only honored when
# ADMIN_TRUST_GATEWAY_HEADERS=true. Empty = any authenticated gateway user.
# Recognized inbound headers (first non-empty wins):
#   Cf-Access-Authenticated-User-Email
#   X-Forwarded-User
#   X-Admin-Email
ADMIN_ALLOWED_EMAILS=

# ─── Standalone Node server (`npm start`) ───────────────────────────────────
PORT=8080
HOST=0.0.0.0
ADMIN_STATIC_DIR=./dist
