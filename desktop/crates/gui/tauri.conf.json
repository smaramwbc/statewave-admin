{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Statewave Admin",
  "version": "1.0.1",
  "identifier": "io.statewave.admin",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Statewave Admin",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/statewave-admin-server"
    ],
    "resources": {
      "../../../dist": "dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Statewave admin desktop client",
    "longDescription": "Cross-platform desktop wrapper for the Statewave admin web UI, sharing credentials with the statewave-admin CLI.",
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 180
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
